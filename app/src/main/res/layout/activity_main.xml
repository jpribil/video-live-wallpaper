<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="v2.0.0" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Problem reported by the wallpaper or the preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/problemCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/problem_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/problemText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:padding="12dp"
                android:textColor="@color/problem_text"
                android:textSize="13sp"
                tools:text="@string/problem_unsupported" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Preview, shaped like the screen -->
        <io.github.codeg0blin.videowallpaper.PreviewFrame
            android:id="@+id/previewFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/surface">

            <TextureView
                android:id="@+id/previewTexture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/preview_description" />

            <TextView
                android:id="@+id/noVideoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="16dp"
                android:gravity="center"
                android:text="@string/no_video_selected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/importOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/overlay"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/importProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/accent" />

                <TextView
                    android:id="@+id/importText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/importing"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </io.github.codeg0blin.videowallpaper.PreviewFrame>

        <TextView
            android:id="@+id/panHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/pan_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="holiday.mp4"
            tools:visibility="visible" />

        <Button
            android:id="@+id/pickButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/pick_video"
            android:textColor="@color/text_primary"
            app:cornerRadius="10dp"
            app:strokeColor="@color/accent" />

        <!-- Playback speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/speedSlider"
                android:text="@string/speed_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/speedValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="1.00×" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:value="1.0"
            android:valueFrom="0.25"
            android:valueTo="2.0"
            app:labelBehavior="gone"
            app:thumbColor="@color/accent"
            app:tickVisible="false"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/surface_variant" />

        <!-- Crop mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/crop_label"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/cropToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/cropFillButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/crop_fill"
                android:textColor="@color/toggle_text"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_bg"
                app:strokeColor="@color/accent" />

            <Button
                android:id="@+id/cropFitButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/crop_fit"
                android:textColor="@color/toggle_text"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_bg"
                app:strokeColor="@color/accent" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Trim (videos only) -->
        <LinearLayout
            android:id="@+id/trimSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/trimSlider"
                    android:text="@string/trim_label"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/trimValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="0:02.5 – 0:10.0" />
            </LinearLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/trimSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="1"
                app:labelBehavior="gone"
                app:thumbColor="@color/accent"
                app:trackColorActive="@color/accent"
                app:trackColorInactive="@color/surface_variant" />
        </LinearLayout>

        <!-- Behaviour options -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/parallaxSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/option_parallax"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/powerSaveSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/option_pause_power_save"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/restartSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/option_restart_on_show"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="12dp" />

        <TextView
            android:id="@+id/activeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="@string/wallpaper_active"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/setWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent"
            android:enabled="false"
            android:minHeight="52dp"
            android:text="@string/set_wallpaper"
            android:textColor="@color/text_primary"
            app:cornerRadius="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
