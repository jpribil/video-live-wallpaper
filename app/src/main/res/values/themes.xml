<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's palette is dark-only, so the Material theme is too: with a
         DayNight parent, light mode gave sliders/switches light-theme colours
         on the dark background. Edge-to-edge (enforced from targetSdk 35) is
         handled in MainActivity with window insets. -->
    <style name="Theme.VideoWallpaper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
